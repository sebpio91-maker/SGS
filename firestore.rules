rules_version = '2';

// Diese Regeln in der Firebase-Konsole unter Firestore Database -> Regeln
// einfügen (ersetzt den Standard-Regelinhalt komplett).
//
// Prinzip: Nur angemeldete Nutzer:innen (auch anonym) dürfen lesen/schreiben.
// Threads und Nachrichten können nur erstellt und nie gelöscht werden
// (unveränderlicher Chat-Verlauf) -- Ausnahme: der Titel eines Threads darf
// nachträglich geändert werden (z.B. nachdem das Bild sichtbar ist), alle
// anderen Felder bleiben fix.
service cloud.firestore {
  match /databases/{database}/documents {
    match /threads/{threadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.author is string
        && request.resource.data.author.size() < 100;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.author is string
          && request.resource.data.author.size() < 100
          && (
            (request.resource.data.text is string && request.resource.data.text.size() < 2000)
            || request.resource.data.imageUrl is string
          );
        allow update, delete: if false;
      }
    }
  }
}
